CXX = g++
CXXFLAGS = -O3 -march=native -flto -fstack-protector-strong -std=c++17 -Wall
LDLIBS = -lcrypto

all: server client

server: server.cpp hybrid_common.hpp
	$(CXX) $(CXXFLAGS) -o $@ server.cpp $(LDLIBS)

client: client.cpp hybrid_common.hpp
	$(CXX) $(CXXFLAGS) -o $@ client.cpp $(LDLIBS)

clean:
	rm -f server client

.PHONY: all clean
